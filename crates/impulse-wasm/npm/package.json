{
  "name": "@warpcore/impulse",
  "version": "0.4.0",
  "description": "Impulse SDK for Kaspa: DvP terms, ImpulseVault scripts and funding addresses, compiled to WebAssembly from impulse-core.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kaspakii/impulse",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaspakii/impulse",
    "directory": "crates/impulse-wasm/npm"
  },
  "bugs": {
    "url": "https://github.com/kaspakii/impulse/issues"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./impulse_wasm_bg.wasm": "./pkg/impulse_wasm_bg.wasm"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "pkg/impulse_wasm.js",
    "pkg/impulse_wasm.d.ts",
    "pkg/impulse_wasm_bg.wasm",
    "pkg/impulse_wasm_bg.wasm.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
